#!/usr/bin/env sh
set -eu

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
profile=auto
install_tools=1
install_integrations=1

usage() {
  cat <<'USAGE'
Usage: ./install [--profile auto|linux|darwin] [--without-tools] [--without-integrations]

Install this repository into the current user's home directory.

Profiles:
  auto     Select linux or darwin from uname (default)
  linux    Use the portable cloud/development VM configuration
  darwin   Use the full macOS configuration
USAGE
}

die() {
  printf 'dotfiles: %s\n' "$*" >&2
  exit 1
}

link_path() {
  source_path=$1
  target_path=$2

  if [ -L "$target_path" ]; then
    existing_source=$(readlink "$target_path")
    [ "$existing_source" = "$source_path" ] ||
      die "refusing to retarget existing symlink: $target_path -> $existing_source"
  elif [ -e "$target_path" ]; then
    die "refusing to replace existing path: $target_path"
  else
    ln -s "$source_path" "$target_path"
  fi
  printf 'linked %s -> %s\n' "$target_path" "$source_path"
}

install_herdr_config() {
  config_dir=$HOME/.config/herdr
  config_path=$config_dir/config.toml

  mkdir -p "$config_dir"
  if [ ! -e "$config_path" ]; then
    cp "$repo_dir/config/herdr/config.toml" "$config_path"
    chmod 600 "$config_path"
    printf 'installed %s\n' "$config_path"
  else
    printf 'kept existing %s\n' "$config_path"
  fi
}

ensure_source_hook() {
  target_path=$1
  source_line=$2
  hook_description=$3

  if [ -L "$target_path" ]; then
    die "refusing to replace existing symlink: $target_path -> $(readlink "$target_path")"
  fi

  if [ -e "$target_path" ]; then
    [ -f "$target_path" ] || die "refusing to modify non-file path: $target_path"
    if grep -Fqx "$source_line" "$target_path"; then
      printf 'kept existing hook in %s\n' "$target_path"
      return
    fi
    printf '\n# Load %s.\n%s\n' "$hook_description" "$source_line" >>"$target_path"
    printf 'added login hook to %s\n' "$target_path"
    return
  fi

  {
    printf '# Load %s.\n' "$hook_description"
    printf '%s\n' "$source_line"
  } >"$target_path"
  chmod 644 "$target_path"
  printf 'installed %s\n' "$target_path"
}

install_linux_shell_hooks() {
  # shellcheck disable=SC2016
  linux_profile='. "$HOME/.dotfiles/profile.linux"'
  for target_path in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.zprofile"; do
    ensure_source_hook "$target_path" "$linux_profile" "the dotfiles Linux login environment"
  done
}

install_darwin_zsh_hook() {
  # shellcheck disable=SC2016
  ensure_source_hook \
    "$HOME/.zshrc" \
    '. "$HOME/.dotfiles/zshrc"' \
    "the tracked dotfiles macOS Zsh configuration"
}

herdr_bin() {
  if command -v herdr >/dev/null 2>&1; then
    command -v herdr
  elif [ -x "$HOME/.local/bin/herdr" ]; then
    printf '%s\n' "$HOME/.local/bin/herdr"
  else
    return 1
  fi
}

install_herdr() {
  if ! herdr_bin >/dev/null 2>&1; then
    command -v curl >/dev/null 2>&1 || die "curl is required to install Herdr"
    printf 'installing Herdr from https://herdr.dev/install.sh\n'
    curl -fsSL https://herdr.dev/install.sh | sh
  fi

  resolved_herdr=$(herdr_bin) || die "Herdr installer completed without a runnable binary"
  "$resolved_herdr" --version

  if [ "$install_integrations" -eq 1 ]; then
    mkdir -p "$HOME/.claude" "$HOME/.codex"
    "$resolved_herdr" integration install claude
    "$resolved_herdr" integration install codex
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile)
      [ "$#" -ge 2 ] || die "--profile requires a value"
      profile=$2
      shift 2
      ;;
    --without-tools)
      install_tools=0
      shift
      ;;
    --without-integrations)
      install_integrations=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ "$profile" = auto ]; then
  case $(uname -s) in
    Linux) profile=linux ;;
    Darwin) profile=darwin ;;
    *) die "unsupported operating system: $(uname -s)" ;;
  esac
fi

case "$profile" in
  linux)
    zshrc_source=$repo_dir/zshrc.linux
    gitconfig_source=$repo_dir/gitconfig.linux
    ;;
  darwin)
    gitconfig_source=$repo_dir/gitconfig
    ;;
  *)
    die "unsupported profile: $profile"
    ;;
esac

mkdir -p "$HOME/.config" "$HOME/.local/bin"
link_path "$gitconfig_source" "$HOME/.gitconfig"
link_path "$repo_dir/githelpers" "$HOME/.githelpers"
link_path "$repo_dir/gitignore" "$HOME/.gitignore"
link_path "$repo_dir/psqlrc" "$HOME/.psqlrc"
link_path "$repo_dir/bin" "$HOME/bin"
if [ "$profile" = linux ]; then
  link_path "$zshrc_source" "$HOME/.zshrc"
  install_linux_shell_hooks
else
  install_darwin_zsh_hook
fi
install_herdr_config

if [ "$install_tools" -eq 1 ]; then
  install_herdr
fi

printf 'installed %s profile from %s\n' "$profile" "$repo_dir"
